# Copy to .env and fill in. .env is git-ignored.
# API host of the tenant (the "-api" host shown in the communication arrangement), no trailing slash
S4_API_URL=https://<tenant>-api.s4hana.cloud.sap
# Communication user of the communication system used by the agent
S4_USER=<communication user>
S4_PASSWORD=<password>
# Optional: default posting date for goods receipts (YYYY-MM-DD), label shown on approval pages, demo tag
# S4_POSTING_DATE=2026-05-25
# S4_SYSTEM_LABEL=S/4HANA Cloud, company code 2910
# DEMO_TAG=GRIR2
# AUDIT_OPERATOR=basis.admin

# Web page with chat (npm run web): no key needed, it uses your own signed-in Claude Code.
# Optional: model alias for the chat (default sonnet; opus is stronger and slower)
# CHAT_MODEL=sonnet
